# Copy to .env and edit. Never commit the real .env file.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Required in production: a random string of 32+ characters
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# Defaults to server/cms.db so your existing data is kept
DB_PATH=
UPLOAD_DIR=
ESCALATION_INTERVAL_MS=300000
# true creates demo accounts (admin, staff, department head, student). Default: true except in production
SEED_DEMO=true
